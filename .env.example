# PanelCraft AI — Multi-Tenant Cloud SaaS Configuration

# Database: leave DATABASE_URL blank for embedded SQLite, or set PostgreSQL URL for Cloud SaaS
PANELCRAFT_DB_PATH=/data/panelcraft.db
DATABASE_URL=postgresql://panelcraft:panelcraft_secret@postgres:5432/panelcraft
POSTGRES_USER=panelcraft
POSTGRES_PASSWORD=panelcraft_secret
POSTGRES_DB=panelcraft

# Authentication & RBAC (set PANELCRAFT_AUTH_REQUIRED=true in production)
PANELCRAFT_AUTH_REQUIRED=false
PANELCRAFT_JWT_SECRET=change-me-to-a-long-random-secret
PANELCRAFT_JWT_EXPIRY_SEC=604800

# Cloud LLM Gateway (openai_compat | ollama | builtin)
PANELCRAFT_LLM_PROVIDER=openai_compat
PANELCRAFT_LLM_BASE_URL=https://api.openai.com/v1
PANELCRAFT_LLM_MODEL=gpt-4o-mini
PANELCRAFT_LLM_API_KEY=

# GitHub Releases Auto-Updater & Community
PANELCRAFT_GITHUB_REPO=panelcraft-ai/panelcraft-ai
